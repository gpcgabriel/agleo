from collections.abc import Sequence

from geopy.point import Point

PointLike = Point | Sequence[float] | str

class Distance:
    def __init__(self, *args: PointLike, **kwargs: float) -> None: ...
    @property
    def km(self) -> float: ...
    @property
    def kilometers(self) -> float: ...
    def destination(self, point: PointLike, bearing: float, distance: Distance | float | None = None) -> Point: ...

class geodesic(Distance): ...
